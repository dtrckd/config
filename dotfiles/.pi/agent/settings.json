{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.2.0",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "theme": "my-dark",
  "defaultThinkingLevel": "high",
  "compaction": {
    "enabled": false
  },
  "skills": [
    "-skills/pi-skills/youtube-transcript/SKILL.md",
    "-skills/pi-skills/gmcli/SKILL.md",
    "-skills/pi-skills/gdcli/SKILL.md",
    "-skills/pi-skills/gccli/SKILL.md",
    "-skills/pi-skills/brave-search/SKILL.md",
    "-skills/pi-skills/transcribe/SKILL.md",
    "-skills/pi-skills/vscode/SKILL.md",
    "+skills/pi-skills/browser-tools/SKILL.md"
  ],
  "packages": [
    "npm:@gotgenes/pi-anthropic-auth",
    "https://github.com/dtrckd/ponytail",
    "npm:pi-usage-meters"
  ],
  "enableInstallTelemetry": false,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "hideThinkingBlock": false,
  "tuiMode": "regular"
}
